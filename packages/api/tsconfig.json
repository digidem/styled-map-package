{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["es2023"],

    "allowJs": true,
    "checkJs": true,
    "module": "NodeNext",
    "moduleDetection": "force",
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    "strict": true,
    "noImplicitOverride": true,
    "forceConsistentCasingInFileNames": true,

    "skipLibCheck": true,
    "typeRoots": ["types", "node_modules/@types"],
    "rootDir": "."
  },
  "include": ["**/*"],
  "exclude": ["node_modules", "dist", "coverage"]
}
